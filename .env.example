# Copy to .env and fill in. Every value here is optional: with none of them set
# the archive runs on SQLite, deterministic embeddings, lexical search and
# extractive answers, and reports that in its health response rather than
# pretending otherwise.
#
# The variable names below are the real ones. There is no DHA_ prefix on
# anything except the HW_ hardware block: a prefixed name is not a variant of
# the real one, it is a variable the process silently ignores. The test suite
# checks that this file and the Dockerfiles name only settings that exist.

# --- required in production -------------------------------------------------
# ENVIRONMENT=production and DEBUG=false are what make the guard in
# app/core/production_guard.py run at all; it never fires in development.
ENVIRONMENT=development
DEBUG=true

# JWT_SECRET is deliberately absent. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A placeholder here would be worse than nothing, because the guard rejects the
# shipped default and would refuse to start for a reason the file implies is
# already handled.

# The database. SQLite is a development convenience; it cannot hold the
# full-text and vector types the schema uses, so a deployed archive needs
# PostgreSQL with the `vector` and `pg_trgm` extensions.
# DATABASE_URL=postgresql+psycopg://archive:password@host:5432/archive

# Only needed when the interface and API are served from different origins.
# With a single-port deployment this can be left empty.
# CORS_ORIGINS=["https://archive.example.org"]

# PUBLIC_BASE_URL is what appears in citation links and the offline page, so it
# must be the address a reader actually visits.
# PUBLIC_BASE_URL=https://archive.example.org

# --- compose plumbing --------------------------------------------------------
# Used by the database container in docker-compose.yml. The application never
# reads these; the connection string comes from DATABASE_URL above.
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=archive

# --- ports ------------------------------------------------------------------
# Published on the host by compose. On a platform that assigns the port, the
# service reads PORT from the environment instead.
WEB_PORT=8080
API_PORT=8000

# --- storage ----------------------------------------------------------------
# filesystem works with no external service. It is also ephemeral on most
# platforms, so uploaded scans and OCR results are lost on redeploy unless a
# disk is attached or an object store is configured.
STORAGE_BACKEND=filesystem
LOCAL_STORAGE_PATH=/var/lib/dha/objects

# --- optional model providers ------------------------------------------------
# Left empty on purpose: with no provider the archive is honest about what it
# can do instead of failing at query time.
LLM_PROVIDER=none
LLM_API_KEY=

# --- kiosk hardware ----------------------------------------------------------
# Read by the Electron process and pushed to the renderer at load. Names are
# HW_-prefixed, unlike everything above.
HW_KIOSK_MODE=true
HW_KIOSK_IDLE_TIMEOUT_SECONDS=180
HW_KIOSK_RETURN_HOME=true
HW_TOUCH_MIN_TARGET_PX=48
HW_SPEAKER_ENABLED=true
